# Copy to .env for local development (never commit the real file).
# See README.md for what each variable means and how it's used.

# ── PostgreSQL (source) ──────────────────────────────────────────────
PG_HOST=localhost
PG_DATABASE=appdb
PG_USER=cdc_reader
PG_PORT=5432
# Local/dev only — plain password auth instead of the Azure AD cert flow.
PG_PASSWORD=changeme

CDC_TABLES=public.customers,public.customer_devices
CDC_PUBLICATION=cdc_pub
CDC_SLOT=cdc_slot
CDC_POLL_INTERVAL_S=2.0
CDC_POLL_BATCH_SIZE=500

# ── Azure AD certificate auth (production PostgreSQL connections) ───
# Leave unset for local dev with PG_PASSWORD above.
# SP_TENANT_ID=
# SP_CLIENT_ID=
# SOURCE_KV_MI_CLIENT_ID=
# SOURCE_KV_NAME=
# CERT_SECRET_NAME=cert-cdc-reader

# ── Snowflake ─────────────────────────────────────────────────────────
# Local/dev: set these directly. Production: fetched from Key Vault
# via SNOWFLAKE_KV_MI_CLIENT_ID / SNOWFLAKE_KV_NAME instead.
SNOWFLAKE_ACCOUNT=your_account.your_region
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=changeme
SNOWFLAKE_DATABASE=ANALYTICS_DEV
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_KV_MI_CLIENT_ID=
# SNOWFLAKE_KV_NAME=

SF_BATCH_SIZE=500
SF_FLUSH_INTERVAL_S=10
SF_MAX_RETRIES=5
SF_RETRY_BASE_S=2

# ── Observability (optional) ─────────────────────────────────────────
LOG_LEVEL=INFO
# DD_API_KEY=
# DD_APP_KEY=
# DD_SITE=datadoghq.com
# DD_AGENT_HOST=
DD_ENV=dev
DD_SERVICE=pg-snowflake-cdc

# ── Health server ─────────────────────────────────────────────────────
HEALTH_PORT=8080

# ── Sync check ────────────────────────────────────────────────────────
SYNC_DRIFT_THRESHOLD=100
SYNC_CHECK_INTERVAL_H=24
